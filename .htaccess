# Use this when the domain's document root is the PROJECT folder (the one containing app/, public/, data/).
# Better: point the document root to public/ and ignore this file.
Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
RewriteEngine On

# private folders / files are never served
RewriteRule ^(app|data|database|design-backup)(/|$) - [F,L]
RewriteRule ^(config\.php|run\.bat|README\.md|GOVERNMENT_PRESENTATION\.md)$ - [F,L]

# static assets live in public/
RewriteCond %{DOCUMENT_ROOT}/public%{REQUEST_URI} -f
RewriteRule ^(.*)$ public/$1 [L]

# everything else -> front controller
RewriteCond %{REQUEST_URI} !^/public/
RewriteRule ^ public/index.php [L]
</IfModule>
